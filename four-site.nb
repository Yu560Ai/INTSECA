Cell["\<\
we should do a composition : 16x26 times 26x16 to obtain this 16x16 U matrix, \
as we need to use the 26d quotient space.\
\>", "Text",
 CellChangeTimes->{{3.963816103340669*^9, 3.963816189966513*^9}, 
   3.963824561065556*^9},ExpressionUUID->"9b146329-ad94-ef4e-b17b-\
52c554781b97"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"UmatrixK0", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"basisKinematic", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "/.", "sol"}], ",", 
       RowBox[{"basis", "[", 
        RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "basisKinematic", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{"Length", "[", "basis", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"UK0inv", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"PseudoInverse", "[", "UmatrixK0", "]"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.941255834076559*^9, 3.94125592643622*^9}, {
  3.9638159738786964`*^9, 3.9638160035771313`*^9}, {3.963816056314684*^9, 
