Cell["\<\
we should do a composition : 16x26 times 26x16 to obtain this 16x16 U matrix, \
as we need to use the 26d quotient space.\
\>", "Text",
 CellChangeTimes->{{3.9638161033406696`*^9, 3.9638161899665127`*^9}, 
   3.9638245610655556`*^9},ExpressionUUID->"9d1271ec-75fe-0b4f-b506-\
f719ca034b92"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"UmatrixK0", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"basisKinematic", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "/.", "sol"}], ",", 
       RowBox[{"basis", "[", 
        RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "basisKinematic", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{"Length", "[", "basis", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"UK0inv", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"PseudoInverse", "[", "UmatrixK0", "]"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.941255834076559*^9, 3.94125592643622*^9}, {
