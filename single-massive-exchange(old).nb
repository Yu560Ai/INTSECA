Cell["then add the basis for old letters if linearly-independent:", "Text",
 CellChangeTimes->{{3.963808740314911*^9, 
  3.9638087596404347`*^9}},ExpressionUUID->"445badaa-d3c8-1c46-9e20-\
5a7ef7c6e40c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CheckDependent", "[", 
   RowBox[{"lvn_List", ",", "i_", ",", "Basis_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"eqn", ",", "sol"}], "}"}], ",", 
    RowBox[{
     RowBox[{"eqn", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Basis", ".", 
            RowBox[{"(", 
             RowBox[{"c", "/@", 
              RowBox[{"Range", "[", 
               RowBox[{"Length", "[", "Basis", "]"}], "]"}]}], ")"}]}], "-", 
           RowBox[{"lvn", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ",", "#"}], "]"}], "&"}], "/@", 
       "basis"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sol", "=", 
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"eqn", "==", "0"}], ",", 
        RowBox[{
         RowBox[{"Cases", "[", 
          RowBox[{"eqn", ",", "_c", ",", "Infinity"}], "]"}], "//", 
         "Union"}]}], "]"}]}], 
     RowBox[{"(*", 
      RowBox[{"//", "First"}], "*)"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"sol", "=!=", 
         RowBox[{"{", "}"}]}], ",", "True", ",", "False"}], "]"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.941078396145267*^9, 3.9410784178000183`*^9}},
 CellLabel->
  "In[111]:=",ExpressionUUID->"c6dc2d01-d7a9-9f4e-a1f4-812c633660f5"],

