Cell[CellGroupData[{

Cell["ODE for \[Psi]", "Subsection",
 CellChangeTimes->{{3.963804029037817*^9, 3.963804051504532*^9}, {
  3.963825481918915*^9, 
  3.9638254881993046`*^9}},ExpressionUUID->"7ee6d24d-bbcc-1a46-9c2b-\
f9d954590e54"],

Cell["Translate A-matrix to ODE of the correlator:", "Text",
 CellChangeTimes->{{3.9638040671274247`*^9, 
  3.96380410170714*^9}},ExpressionUUID->"28e4025b-afc9-a649-af41-\
870f00bb22cb"],

Cell[BoxData[
 RowBox[{"ClearAll", "[", "A", "]"}]], "Input",
 CellChangeTimes->{{3.9638250341038084`*^9, 3.963825037019417*^9}},
 CellLabel->
  "In[351]:=",ExpressionUUID->"15cf44b8-fd6e-0a45-8464-6345264ff4f4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"log", "[", 
    RowBox[{"a_", " ", "b_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"log", "[", "a", "]"}], "+", 
    RowBox[{"log", "[", "b", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"log", "[", 
    SuperscriptBox["a__", "b__"], "]"}], ":=", 
   RowBox[{"b", " ", 
    RowBox[{"log", "[", "a", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"log", "[", "a_", "]"}], ":=", 
   RowBox[{"Log", "[", "a", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dlkin", "[", "a_", "]"}], ":=", " ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"log", "[", "a", "]"}], ",", 
          RowBox[{"y", "[", "i", "]"}]}], "]"}], 
        RowBox[{"dy", "[", "i", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "KinDim"}], "}"}]}], "]"}], "//", "Total"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"initiate", "[", "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"dA", ",", "M", ",", "MI", ",", "MIFirstRowCoeff"}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dA", "[", "0", "]"}], ":=", "A"}], ";", " ", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dA", "[", "i_", "]"}], ":=", 
     RowBox[{
      RowBox[{"dA", "[", "i", "]"}], "=", " ", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"dA", "[", 
          RowBox[{"i", "-", "1"}], "]"}], ",", 
         RowBox[{"y", "[", "kN", "]"}]}], "]"}], "+", 
       RowBox[{
        RowBox[{"dA", "[", 
         RowBox[{"i", "-", "1"}], "]"}], ".", "A"}]}]}]}], 
    RowBox[{"(*", 
     RowBox[{"//", "Simplify"}], "*)"}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dAI", "[", "i_", "]"}], ":=", 
     RowBox[{
      RowBox[{"dAI", "[", "i", "]"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"dA", "[", "i", "]"}], ".", "IVec"}], "//", "Simplify"}]}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"M", "[", "Ddeg_", "]"}], ":=", 
     RowBox[{
      RowBox[{"M", "[", "Ddeg", "]"}], "=", 
      RowBox[{
       RowBox[{"dA", "[", 
        RowBox[{"Ddeg", "-", "1"}], "]"}], "+", 
       RowBox[{"(", " ", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"a", "[", "i", "]"}], 
            RowBox[{"dA", "[", 
             RowBox[{"i", "-", "1"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Ddeg", "-", "1"}]}], "}"}]}], "]"}], "//", "Total"}], 
        ")"}], "+", 
       RowBox[{
        RowBox[{"a", "[", "0", "]"}], 
        RowBox[{"IdentityMatrix", "[", "Adim", "]"}]}]}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"MI", "[", "Ddeg_", "]"}], ":=", 
     RowBox[{
      RowBox[{"M", "[", "Ddeg", "]"}], ".", "IVec"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"MIFirstRowCoeff", "[", "Ddeg_", "]"}], ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"MI", "[", "Ddeg", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
      "IVec"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"MIGeneralCoeff", "[", 
       RowBox[{"Ddeg_", ",", "\[Psi]_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"MI", "[", "Ddeg", "]"}], ".", 
           RowBox[{"Overlap", "[", "\[Psi]", "]"}]}], ",", "#"}], "]"}], 
        "&"}], "/@", "IVec"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
   ")"}]}]}], "Input",
 CellLabel->
  "In[352]:=",ExpressionUUID->"590e3303-655a-8a4a-a20d-e3a4b9e7845c"],

