Cell[CellGroupData[{

Cell["lower-triangular", "Subsubsection",
 CellChangeTimes->{{3.9683674636479607`*^9, 
  3.9683674671925907`*^9}},ExpressionUUID->"f9d0f652-747b-9c4d-86e7-\
5f9eb567f080"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Convert", " ", "string", " ", "symbols", " ", "like", " ", "\"\<L3\>\"", 
    " ", "to", " ", "symbols", " ", "L3"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"toSymbols", "[", "m_", "]"}], ":=", 
     RowBox[{"m", "/.", " ", 
      RowBox[{"s_String", ":>", 
       RowBox[{"ToExpression", "[", "s", "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Conjugation", " ", "by", " ", "S"}], "=", 
      RowBox[{"I", "+", 
       RowBox[{"\[Alpha]", " ", "E_", 
        RowBox[{"{", "pq", "}"}], " ", "on", " ", "a", " ", "sub"}], "-", 
       RowBox[{"block", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"indices", "'"}], 
          RowBox[{"rest", "'"}]}], ")"}]}]}]}], ",", 
     RowBox[{
     "embedded", " ", "into", " ", "the", " ", "full", " ", "matrix"}], ",", 
     RowBox[{"keeping", " ", "index", " ", "1", " ", 
      RowBox[{"fixed", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"conjugateElementary", "[", 
      RowBox[{
      "m_", ",", "rest_List", ",", "p_", ",", "q_", ",", "\[Alpha]_"}], "]"}],
      ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", "=", 
          RowBox[{"Length", "[", "m", "]"}]}], ",", 
         RowBox[{"k", "=", 
          RowBox[{"Length", "[", "rest", "]"}]}], ",", "Sblk", ",", "Sfull"}],
         "}"}], ",", 
       RowBox[{
        RowBox[{"Sblk", "=", 
         RowBox[{"IdentityMatrix", "[", "k", "]"}]}], ";", 
        RowBox[{
         RowBox[{"Sblk", "[", 
          RowBox[{"[", 
           RowBox[{"p", ",", "q"}], "]"}], "]"}], "=", "\[Alpha]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Sfull", "=", 
         RowBox[{"IdentityMatrix", "[", "n", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Sfull", "[", 
          RowBox[{"[", 
           RowBox[{"rest", ",", "rest"}], "]"}], "]"}], "=", "Sblk"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Inverse", "[", "Sfull", "]"}], ".", "m", ".", "Sfull"}]}]}],
       "  ", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"since", " ", "Sblk", " ", "is", " ", "unitriangular"}], ",", 
        RowBox[{
         RowBox[{"Inverse", " ", "is", " ", "I"}], "-", 
         RowBox[{"\[Alpha]", " ", "E_", 
          RowBox[{"{", "pq", "}"}]}]}]}], "*)"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Try", " ", "to", " ", "zero", " ", 
      RowBox[{"A", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j"}], "]"}], "]"}], " ", 
      RowBox[{"(", 
       RowBox[{"i", "<", "j"}], ")"}], " ", "inside", " ", "sub"}], "-", 
     RowBox[{
     "block", " ", "by", " ", "similarity", " ", "using", " ", "pivot", " ", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "i"}], "]"}], "]"}], "."}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"killAbove", "[", 
      RowBox[{"m_", ",", "rest_List", ",", "i_", ",", "j_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"A", "=", 
          RowBox[{"m", "[", 
           RowBox[{"[", 
            RowBox[{"rest", ",", "rest"}], "]"}], "]"}]}], ",", "aii", ",", 
         "aij", ",", "\[Alpha]"}], "}"}], ",", 
       RowBox[{
        RowBox[{"aii", "=", 
         RowBox[{"A", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "i"}], "]"}], "]"}]}], ";", 
        RowBox[{"aij", "=", 
         RowBox[{"A", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"aij", "===", "0"}], ",", "m", ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"aii", "=!=", "0"}], "&&", 
             RowBox[{"FreeQ", "[", 
              RowBox[{"aii", ",", "0"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"\[Alpha]", "=", 
              RowBox[{
               RowBox[{"-", "aij"}], "/", "aii"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"conjugateElementary", "[", 
              RowBox[{"m", ",", "rest", ",", "j", ",", "i", ",", "\[Alpha]"}],
               "]"}]}], ",", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"pivot", " ", 
               RowBox[{"zero", ":", "skip"}]}], ";", 
              RowBox[{
              "could", " ", "also", " ", "try", " ", "swapping", " ", 
               "inside", " ", "subspace", " ", "if", " ", "allowed"}]}], 
             "*)"}], "m"}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Drive", " ", "last", " ", "5", "\[Times]", "5", " ", "block", " ", 
     "toward", " ", "lower", " ", "triangular", " ", "by", " ", "wiping", " ",
      "strictly", " ", "upper", " ", 
     RowBox[{"triangle", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"LowerTriangularizeLast5Symbolic", "[", 
      RowBox[{"m0_", "?", "MatrixQ"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"m", "=", 
          RowBox[{"toSymbols", "[", "m0", "]"}]}], ",", "n", ",", "rest", ",",
          "k", ",", "i", ",", "j", ",", 
         RowBox[{"S", "=", 
          RowBox[{"IdentityMatrix", "[", 
           RowBox[{"Length", "[", "m0", "]"}], "]"}]}], ",", "Sstep", ",", 
         "A"}], "}"}], ",", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"n", "<", "6"}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rest", "=", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"n", "-", "4"}], ",", "n"}], "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{
         "indices", " ", "of", " ", "the", " ", "last", " ", "5", " ", 
          "coordinates"}], "*)"}], 
        RowBox[{"k", "=", 
         RowBox[{"Length", "[", "rest", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "Perform", " ", "elimination", " ", "column", " ", "by", " ", 
           "column"}], ",", 
          RowBox[{
           RowBox[{"row", " ", "by", " ", 
            RowBox[{"row", ":", "i"}]}], "=", 
           RowBox[{
            RowBox[{"1", ".."}], "k"}]}], ",", 
          RowBox[{"j", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"k", ".."}], "i"}], "+", "1"}]}]}], "*)"}], 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"Do", "[", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"one", " ", "similarity", " ", "step", " ", "on", " ", 
              RowBox[{"(", 
               RowBox[{"i", ",", "j"}], ")"}], " ", "inside", " ", "the", " ",
               "sub"}], "-", "block"}], "*)"}], 
           RowBox[{
            RowBox[{
             RowBox[{"m", "=", 
              RowBox[{"killAbove", "[", 
               RowBox[{"m", ",", "rest", ",", "i", ",", "j"}], "]"}]}], ";"}],
             ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "k", ",", 
              RowBox[{"i", "+", "1"}], ",", 
              RowBox[{"-", "1"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"k", "-", "1"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "m"}]}], "]"}]}], ";"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.968368892891859*^9, 3.968368892891859*^9}},
 CellLabel->
  "In[433]:=",ExpressionUUID->"082a5e12-d51f-d248-9108-1634cc87064b"],

