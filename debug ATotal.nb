Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Total", " ", "derivative", " ", "A"}], "-", "matrix"}], "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"toPositive", "=", 
     RowBox[{"x_", ":>", 
      RowBox[{
       RowBox[{"-", "x"}], "/;", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"First", "[", "x", "]"}], "//", "Length"}], ")"}], "==", 
        "2"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"toLogForm", "[", 
     RowBox[{"expr_", ",", "i_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\n", 
     RowBox[{
      RowBox[{"{", "terms", "}"}], ",", 
      RowBox[{
       RowBox[{"terms", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", "expr", "]"}], "===", "Plus"}], ",", 
          RowBox[{"List", "@@", "expr"}], ",", 
          RowBox[{"{", "expr", "}"}]}], "]"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{
        "Check", " ", "if", " ", "the", " ", "input", " ", "is", " ", "a", 
         " ", "sum", " ", "or", " ", "a", " ", "single", " ", "term"}], 
        "*)"}], "\n", 
       RowBox[{"terms", "//", "Simplify"}], ";", "\n", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Numerator", "[", "term", "]"}], "*", 
            RowBox[{
             RowBox[{"Log", "[", 
              RowBox[{
               RowBox[{"Denominator", "[", "term", "]"}], "/.", 
               "toPositive"}], "]"}], "/", 
             RowBox[{"Coefficient", "[", 
              RowBox[{
               RowBox[{"Denominator", "[", "term", "]"}], ",", 
               RowBox[{"kin", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}]}], "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ComplexInfinity", "->", "0"}], ",", 
             RowBox[{"Indeterminate", "->", "0"}]}], "}"}]}], "//", "Quiet"}],
          ",", 
         RowBox[{"{", 
          RowBox[{"term", ",", "terms"}], "}"}]}], "]"}]}]}], 
     RowBox[{"(*", 
      RowBox[{
      "Process", " ", "each", " ", "term", " ", "individually", " ", "and", 
       " ", "return", " ", "the", " ", "results", " ", "as", " ", "a", " ", 
       "list"}], "*)"}], "\n", "]"}]}], "\n", 
   RowBox[{
    RowBox[{"splitPlus", "=", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MatchQ", "[", 
         RowBox[{"#", ",", "_Plus"}], "]"}], ",", 
        RowBox[{"List", "@@", "#"}], ",", 
        RowBox[{"{", "#", "}"}]}], "]"}], "&"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"transformList", "=", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"splitPlus", "/@", 
        RowBox[{"(", 
         RowBox[{"FactorTerms", "/@", "#"}], ")"}]}], "]"}], "&"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ATotalOld", "[", 
      RowBox[{"A_List", ",", "twists_List"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"twist", "*", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{"Union", "[", 
              RowBox[{"Flatten", "[", 
               RowBox[{"#", "//", 
                RowBox[{"MapIndexed", "[", 
                 RowBox[{
                  RowBox[{"toLogForm", "[", 
                   RowBox[{"#", ",", 
                    RowBox[{"First", "[", "#2", "]"}]}], "]"}], "&"}], 
                 "]"}]}], "]"}], "]"}], "]"}], "&"}], ",", 
           RowBox[{"MapThread", "[", 
            RowBox[{"List", ",", 
             RowBox[{"Coefficient", "[", 
              RowBox[{"A", ",", "twist"}], "]"}], ",", "2"}], "]"}], ",", 
           RowBox[{"{", "2", "}"}]}], " ", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"twist", ",", "twists"}], "}"}]}], "]"}], "//", "Quiet"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ATotalNew", "[", 
      RowBox[{"A_List", ",", "twists_List"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "result", "}"}], ",", "\n", 
        RowBox[{
         RowBox[{"result", "=", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"transformList", "[", "#", "]"}], "&"}], ",", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"MapIndexed", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"toLogForm", "[", 
                   RowBox[{"#1", ",", 
                    RowBox[{"First", "@", "#2"}]}], "]"}], "&"}], ",", "#"}], 
                "]"}], "&"}], ",", 
              RowBox[{"MapThread", "[", 
               RowBox[{"List", ",", 
                RowBox[{"Coefficient", "[", 
                 RowBox[{"A", ",", 
                  RowBox[{"twists", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", "2"}], "]"}],
               ",", 
              RowBox[{"{", "2", "}"}]}], "]"}], ",", 
            RowBox[{"{", "3", "}"}]}], "]"}]}], ";", "\n", 
         RowBox[{"Sum", "[", "\n", 
          RowBox[{
           RowBox[{"twist", "*", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Total", "[", 
                RowBox[{"Union", "[", 
                 RowBox[{"Flatten", "[", "#", "]"}], "]"}], "]"}], "&"}], ",",
               "result", ",", 
              RowBox[{"{", "2", "}"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"twist", ",", "twists"}], "}"}]}], "\n", "]"}]}]}], "]"}],
       "//", "Quiet"}]}], ";"}]}]}]], "Code",
