Cell[BoxData[
 RowBox[{
  RowBox[{"CheckDependent", "[", 
   RowBox[{"lvn_List", ",", "i_", ",", "Basis_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"eqn", ",", "vars", ",", "sol"}], "}"}], ",", 
    RowBox[{
     RowBox[{"eqn", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Basis", ".", 
            RowBox[{"(", 
             RowBox[{"c", "/@", 
              RowBox[{"Range", "[", 
               RowBox[{"Length", "[", "Basis", "]"}], "]"}]}], ")"}]}], "-", 
           RowBox[{"lvn", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ",", "#"}], "]"}], "&"}], "/@", 
       "basisNeed"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vars", "=", 
      RowBox[{"Union", "@", 
       RowBox[{"Cases", "[", 
        RowBox[{"eqn", ",", "_c", ",", "Infinity"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sol", "=", 
      RowBox[{"Quiet", "@", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{"eqn", "==", "0"}], "]"}], ",", "vars"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sol", "=!=", 
      RowBox[{"{", "}"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.963957295893032*^9, 3.963957301388668*^9}, 
   3.963957860210436*^9},
 CellLabel->
  "In[1568]:=",ExpressionUUID->"204d7403-2345-6945-be73-a5f478094fe9"],

