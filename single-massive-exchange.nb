Cell["then add the basis for old letters if linearly-independent:", "Text",
 CellChangeTimes->{{3.963808740314911*^9, 
  3.963808759640435*^9}},ExpressionUUID->"f80938ec-2c03-9f43-ab67-\
3c009e941acb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CheckDependent", "[", 
   RowBox[{"lvn_List", ",", "i_", ",", "Basis_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"eqn", ",", "sol"}], "}"}], ",", 
    RowBox[{
     RowBox[{"eqn", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Basis", ".", 
            RowBox[{"(", 
             RowBox[{"c", "/@", 
              RowBox[{"Range", "[", 
               RowBox[{"Length", "[", "Basis", "]"}], "]"}]}], ")"}]}], "-", 
           RowBox[{"lvn", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ",", "#"}], "]"}], "&"}], "/@", 
       "basisNeed"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sol", "=", 
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"eqn", "==", "0"}], ",", 
