            RowBox[{"(", 
             RowBox[{"c", "/@", 
              RowBox[{"Range", "[", 
               RowBox[{"Length", "[", "Basis", "]"}], "]"}]}], ")"}]}], "-", 
           RowBox[{"lvn", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ",", "#"}], "]"}], "&"}], "/@", 
       "basis"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sol", "=", 
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"eqn", "==", "0"}], ",", 
        RowBox[{
         RowBox[{"Cases", "[", 
          RowBox[{"eqn", ",", "_c", ",", "Infinity"}], "]"}], "//", 
         "Union"}]}], "]"}]}], 
     RowBox[{"(*", 
      RowBox[{"//", "First"}], "*)"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"sol", "=!=", 
         RowBox[{"{", "}"}]}], ",", "True", ",", "False"}], "]"}], "]"}]}]}], 
