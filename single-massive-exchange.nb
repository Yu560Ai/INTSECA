Cell[BoxData[
 RowBox[{
  RowBox[{"CheckDependent", "[", 
   RowBox[{"lvn_List", ",", "i_", ",", "Basis_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"eqn", ",", "vars", ",", "sol"}], "}"}], ",", 
    RowBox[{
     RowBox[{"eqn", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Basis", ".", 
            RowBox[{"(", 
             RowBox[{"c", "/@", 
              RowBox[{"Range", "[", 
               RowBox[{"Length", "[", "Basis", "]"}], "]"}]}], ")"}]}], "-", 
           RowBox[{"lvn", "[", 
