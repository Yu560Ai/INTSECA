Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"coordinate", "[", "Vertex_", "]"}], ":=", "\n", 
   RowBox[{"First", "@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Lplanes", "[", 
             RowBox[{"[", "#", "]"}], "]"}], "==", "0"}], "&"}], ",", 
          RowBox[{"tp", "[", "Vertex", "]"}]}], "]"}], ",", 
        RowBox[{"X", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", "dim"}], "]"}], "]"}]}], "]"}], "//", 
      "Simplify"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"multiIntsec", "[", "vertexToIntsec_List", "]"}], ":=", 
  RowBox[{"(", "\n", 
   RowBox[{
    RowBox[{"Hypers", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"vertexToIntsec", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "#", "]"}], ">", "1"}], "&"}]}], "]"}]}], ";",
     "\n", 
    RowBox[{"Return", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{"Hypers", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}], "==", "0"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "Hypers", "]"}]}], "}"}]}], "]"}], "]"}]}], 
   "\n", ")"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"multiRelations", "[", "vertices_List", "]"}], ":=", 
  RowBox[{"(", "\n", 
   RowBox[{
    RowBox[{"vertexToIntsec", "=", 
     RowBox[{"GroupBy", "[", 
      RowBox[{"vertices", ",", "coordinate"}], "]"}]}], ";", "\n", 
    RowBox[{"multirelations", "=", 
     RowBox[{"multiIntsec", "[", 
      RowBox[{"vertexToIntsec", "//", "Values"}], "]"}]}], ";", "\n", 
    RowBox[{"Return", "[", "multirelations", "]"}]}], "\n", ")"}]}]}], "Input",
